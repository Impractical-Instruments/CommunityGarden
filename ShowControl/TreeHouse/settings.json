{
  "pico_dioramas": {
    "port": "/dev/treehouse-pico-a",
    "baud": 115200
  },

  "pico_structure": {
    "port": "/dev/treehouse-pico-b",
    "baud": 115200
  },

  "show": {
    "fps": 30,
    "dim_level": 0.25
  },

  "dioramas": [
    {
      "_note": "House Swarming: 3× SK6812 strips. TODO: confirm chained (1 pin) vs separate pins. Set led_count to total pixels.",
