      "pico_id": "dioramas",
      "pico_pin": 0,
      "led_count": 20,
      "brightness": 1.0,
      "color": [255, 180, 80, 255],
      "pattern": "incandescent"
    },
    {
      "_note": "Club: 2× SK6812 strips + transistor superbright LED. TODO: set led_count, transistor_pin when wired.",
      "name": "Club",
      "pico_id": "dioramas",
      "pico_pin": 1,
      "led_count": 20,
      "brightness": 1.0,
      "color": [180, 0, 255, 0],
      "pattern": "chase",
      "transistor_pin": -1,
      "transistor_pico_id": "dioramas",
      "transistor_threshold": 0.6
    }
  ],

  "pwm_displays": [
    {
      "_note": "Mycelium: PWM/transistor LED filament on Pico A pin 2. Reacts to flowerbeds+pipes activity.",
      "name": "Mycelium",
      "pico_pin": 2,
