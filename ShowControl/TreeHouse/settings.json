      "pico_id": "structure",
      "min_value": 20000,
      "max_value": 65535,
      "pulse_period": 15.0,
      "signal_weight_captcha": 0.2,
      "signal_weight_flowerbeds": 0.4,
      "signal_weight_pipes": 0.4
    }
  ],

  "garage_windows": {
    "looking_glass": {
      "name": "Looking Glass",
      "scene": "bloom",
      "speed": 1.0,
      "mirror_depth": 6,
      "renderer_port": 9002
    },
    "forge_and_flora": {
      "_note": "2× SK6812 strips on pins 3+4 + transistor arc flash on pin TBD. Set arc_flash_pin when wired.",
