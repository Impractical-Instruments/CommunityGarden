[Unit]
Description=FundingCAPTCHA Kiosk Browser
After=captcha.service graphical.target
Wants=captcha.service

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
# Wait until the server is actually up before opening Chromium
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:8080/ > /dev/null 2>&1; do sleep 1; done'
ExecStart=chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --no-first-run \
  --disable-translate \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --check-for-update-interval=31536000 \
  http://localhost:8080/
Restart=on-failure
RestartSec=5
User=pi

[Install]
WantedBy=graphical.target
